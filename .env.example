# ─────────────────────────────────────────────────────────────────────────────
# Demo-request email delivery
#
# Copy this file to `.env.local` for local development, and set the same three
# variables in your hosting dashboard for production. `.env.local` is gitignored
# — never commit real keys or real inbox addresses.
#
# Without these the /api/demo-request route returns a clear "not configured"
# error instead of silently dropping enquiries.
# ─────────────────────────────────────────────────────────────────────────────

# API key from https://resend.com/api-keys  (starts with "re_")
RESEND_API_KEY=

# Who receives demo enquiries. Comma-separate for more than one recipient.
#
# Note: until you verify a sending domain in Resend, it will only deliver to
# the address the Resend account was registered with.
DEMO_MAIL_TO=you@example.com

# Verified sender. `onboarding@resend.dev` works with no DNS setup and is the
# quickest way to prove the flow end to end. For production, verify your own
# domain in Resend and use e.g. `ShiftEaze <demo@shifteaze.com>`.
DEMO_MAIL_FROM=ShiftEaze <onboarding@resend.dev>
