# ─────────────────────────────────────────────────────────────────────────────
# Demo-request email delivery (SMTP)
#
# Copy this file to `.env.local` for local development, and set the same
# variables in your hosting dashboard for production. `.env.local` is
# gitignored — never commit real credentials or real inbox addresses.
#
# Without these the /api/demo-request route returns a clear "not configured"
# error instead of silently dropping enquiries.
# ─────────────────────────────────────────────────────────────────────────────

# The mailbox provider's SMTP server, e.g. mail.rcspl.net for shifteaze.io.
# Note: this is NOT smtp.office365.com / Outlook.com.
SMTP_HOST=

# 465 for implicit SSL, 587 for STARTTLS — check what your provider supports.
SMTP_PORT=465

# The mailbox address used to authenticate, e.g. info@shifteaze.io
SMTP_USER=

# The mailbox password, or an app password if the account has MFA enabled.
SMTP_PASS=

# Who receives demo enquiries. Comma-separate for more than one recipient.
# Defaults to SMTP_USER when unset.
DEMO_MAIL_TO=

# The "from" address. Defaults to SMTP_USER. Most providers reject a from
# address that doesn't match the authenticated mailbox — leave this unset
# unless you know your provider allows otherwise.
DEMO_MAIL_FROM=
