# ─────────────────────────────────────────────────────────────────────────────
# Demo-request email delivery (SMTP)
#
# Copy this file to `.env.local` for local development, and set the same
# variables in your hosting dashboard for production. `.env.local` is
# gitignored — never commit real credentials.
#
# Without these the /api/demo-request route returns a clear "not configured"
# error instead of silently dropping enquiries.
# ─────────────────────────────────────────────────────────────────────────────

# The mailbox address used to send, e.g. info@shifteaze.io
SMTP_USER=

# The mailbox password. If the account has MFA/2FA enabled, this may need to
# be an app password generated for it instead of the normal sign-in password.
SMTP_PASS=

# SMTP server for this mailbox's provider. For shifteaze.io this is the
# hosting provider's mail server, not Microsoft 365 / Outlook.com.
SMTP_HOST=mail.rcspl.net

# 465 = implicit SSL/TLS (used here). 587 = STARTTLS, for providers that use it.
SMTP_PORT=465

# Who receives demo enquiries. Comma-separate for more than one recipient.
# Defaults to SMTP_USER if left blank.
DEMO_MAIL_TO=info@shifteaze.io

# Sender shown on the email. Most providers require this to match the
# authenticated mailbox, so leave blank to default to SMTP_USER.
DEMO_MAIL_FROM=
